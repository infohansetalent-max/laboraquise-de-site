</div><script src="/assets/gsap/3.15.0/gsap.min.js"></script><script>
  (function () {
    if (window.__megaNavInit) {
      return;
    }
    window.__megaNavInit = true;

    /* ── CONFIG ──────────────────────────────────────────── */

    /* Mega dropdown animation */
    var MEGA_DUR = {
      bgMorph: 0.4,
      contentIn: 0.3,
      contentOut: 0.2,
      stagger: 0.25,
      backdropIn: 0.3,
      backdropOut: 0.2,
      openScale: 0.35,
      closeScale: 0.25,
    };

    /* Standard dropdown animation */
    var STD_DUR = {
      itemIn: 0.3,
      itemStagger: 0.1,
      itemY: 8,
      ease: 'power3.out',
    };

    /* Hover delays (ms) */
    var HOVER_ENTER = 120;
    var HOVER_LEAVE = 150;

    /* Color change */
    var NAV_SEL = '.mega-nav';
    var DARK_SEL = '[data-theme="dark"]';
    var SCROLL_TH = 24;
    var NAV_OFFSET = 35; /* Abstand von oben, wann Nav wechselt (in px) */

    /* Breakpoint */
    var MOBILE_BP = 991;

    /* ── END CONFIG ──────────────────────────────────────── */

    function waitForGsap(cb) {
      if (typeof gsap !== 'undefined') {
        cb();
        return;
      }
      var c = setInterval(function () {
        if (typeof gsap !== 'undefined') {
          clearInterval(c);
          cb();
        }
      }, 50);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initColor);
    } else {
      initColor();
    }

    waitForGsap(function () {
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initNav);
      } else {
        initNav();
      }
    });

    function initColor() {
      var root = document.documentElement;
      var body = document.body;
      var nav = document.querySelector(NAV_SEL);
      if (!nav) return;
      function getDark() {
        return document.querySelectorAll(DARK_SEL);
      }
      var invertMode = nav.getAttribute('data-nav-dark') === 'active';
      function isD() {
        var fp = nav.getBoundingClientRect().bottom - NAV_OFFSET;
        var s = getDark();
        for (var i = 0; i < s.length; i++) {
          var r = s[i].getBoundingClientRect();
          if (r.top <= fp && r.bottom > fp) return true;
        }
        return false;
      }
      function setS() {
        nav.classList.toggle('scrolled', (window.pageYOffset || root.scrollTop) > SCROLL_TH);
      }
      var was = null;
      function setT() {
        var d = isD();
        if (d === was) return;
        was = d;
        body.classList.toggle('nav-dark', invertMode ? !d : d);
      }
      function up() {
        setT();
        setS();
      }
      up();
      nav.offsetHeight;
      if (!nav.classList.contains('is-visible')) {
        nav.classList.add('is-visible');
      }
      var tk = false;
      function onSR() {
        if (!tk) {
          tk = true;
          requestAnimationFrame(function () {
            up();
            tk = false;
          });
        }
      }
      window.addEventListener('scroll', onSR, { passive: true });
      window.addEventListener('resize', onSR);
      window.addEventListener('load', onSR);
    }

    function initNav() {
      var wrap = document.querySelector('[data-menu-wrap]');
      if (!wrap) return;
      var navList = document.querySelector('[data-nav-list]');
      var dw = document.querySelector('[data-dropdown-wrapper]');
      var dc = document.querySelector('[data-dropdown-container]');
      var bd = document.querySelector('[data-menu-backdrop]');
      var burger = document.querySelector('[data-burger-toggle]');
      var back = document.querySelector('[data-mobile-back]');
      var logo = document.querySelector('[data-menu-logo]');
      var lt = document.querySelector("[data-burger-line='top']");
      var lm = document.querySelector("[data-burger-line='mid']");
      var lb = document.querySelector("[data-burger-line='bot']");
      var allT = [].slice.call(document.querySelectorAll('[data-dropdown-toggle]'));
      var megaT = allT.filter(function (t) {
        return mode(t) === 'mega';
      });
      var panels = [].slice.call(document.querySelectorAll('[data-nav-content]'));

      function mode(t) {
        var l = t.closest('[data-nav-mode]');
        return l ? l.getAttribute('data-nav-mode') : null;
      }
      function panel(n) {
        return document.querySelector("[data-nav-content='" + n + "']");
      }
      function toggle(n) {
        return document.querySelector("[data-dropdown-toggle='" + n + "']");
      }
      function stdDd(n) {
        return document.querySelector("[data-std-dropdown='" + n + "']");
      }
      function fade(e) {
        return e.querySelectorAll('[data-menu-fade]');
      }
      function navItems() {
        return navList.querySelectorAll('[data-nav-list-item]');
      }
      function megaIdx(n) {
        return megaT.indexOf(toggle(n));
      }
      function stag(n) {
        return n <= 1 ? 0 : { amount: MEGA_DUR.stagger };
      }

      var S = { isOpen: false, ap: null, api: -1, mob: window.innerWidth <= MOBILE_BP, mOpen: false, mPanel: null, ht: null, lt: null, tl: null, mtl: null, mptl: null, aStd: null, st: null, stdTl: null };

      function ct() {
        clearTimeout(S.ht);
        clearTimeout(S.lt);
        S.ht = S.lt = null;
      }
      function kl(k) {
        if (S[k]) {
          S[k].kill();
          S[k] = null;
        }
      }
      function kd() {
        kl('tl');
        gsap.killTweensOf(dc);
        gsap.killTweensOf(bd);
        panels.forEach(function (p) {
          gsap.killTweensOf(p);
          gsap.killTweensOf(fade(p));
        });
      }
      function km() {
        kl('mtl');
        gsap.killTweensOf([navList, lt, lm, lb]);
      }
      function kmp() {
        kl('mptl');
        gsap.killTweensOf(navItems());
        gsap.killTweensOf([back, logo]);
        panels.forEach(function (p) {
          gsap.killTweensOf(p);
          gsap.killTweensOf(fade(p));
        });
      }
      function rt() {
        allT.forEach(function (t) {
          t.setAttribute('aria-expanded', 'false');
        });
      }
      function rd() {
        panels.forEach(function (p) {
          gsap.set(p, { visibility: 'hidden', opacity: 0, pointerEvents: 'none', xPercent: 0 });
          gsap.set(fade(p), { autoAlpha: 0, x: 0, y: 0 });
        });
        gsap.set(dc, { height: 0 });
        gsap.set(bd, { autoAlpha: 0 });
        wrap.setAttribute('data-menu-open', 'false');
        rt();
      }
      function sm() {
        panels.forEach(function (p) {
          gsap.set(p, { autoAlpha: 0, xPercent: 0, visibility: 'visible', pointerEvents: 'none' });
          gsap.set(fade(p), { xPercent: 20, autoAlpha: 0 });
        });
        gsap.set(navItems(), { xPercent: 0, y: 0, autoAlpha: 1 });
        gsap.set(navList, { autoAlpha: 0, x: 0 });
        gsap.set(back, { autoAlpha: 0 });
        gsap.set(logo, { autoAlpha: 1 });
        gsap.set(dc, { clearProps: 'height' });
        gsap.set(bd, { autoAlpha: 0 });
      }
      function mp(n) {
        var e = panel(n);
        if (!e) return 0;
        var s = e.style,
          p = [s.visibility, s.opacity, s.pointerEvents];
        Object.assign(s, { visibility: 'visible', opacity: '0', pointerEvents: 'none' });
        var h = e.getBoundingClientRect().height;
        s.visibility = p[0];
        s.opacity = p[1];
        s.pointerEvents = p[2];
        return h;
      }

      function oStd(n) {
        clearTimeout(S.st);
        S.st = null;
        if (S.aStd === n) return;
        if (S.aStd) {
          kl('stdTl');
          var prev = stdDd(S.aStd);
          if (prev) {
            prev.classList.remove('is-open');
            var pl = [].slice.call(prev.querySelectorAll('.mega-nav__panel-link'));
            if (pl.length) gsap.set(pl, { clearProps: 'opacity,visibility,transform' });
          }
          var pt = toggle(S.aStd);
          if (pt) pt.setAttribute('aria-expanded', 'false');
          S.aStd = null;
        }
        var d = stdDd(n);
        if (!d) return;
        if (getComputedStyle(d).display === 'none') return;
        d.classList.add('is-open');
        S.aStd = n;
        var t = toggle(n);
        if (t) t.setAttribute('aria-expanded', 'true');
        var links = [].slice.call(d.querySelectorAll('.mega-nav__panel-link'));
        if (links.length) {
          kl('stdTl');
          links.forEach(function (l) {
            l.style.transition = 'none';
          });
          var tl = gsap.timeline({
            onComplete: function () {
              links.forEach(function (l) {
                l.style.transition = '';
              });
            },
          });
          S.stdTl = tl;
          tl.fromTo(links, { autoAlpha: 0, y: STD_DUR.itemY }, { autoAlpha: 1, y: 0, duration: STD_DUR.itemIn, stagger: STD_DUR.itemStagger, ease: STD_DUR.ease }, 0);
        }
      }

      function cStd(force) {
        if (!S.aStd) return;
        var name = S.aStd;
        kl('stdTl');
        var d = stdDd(name);
        if (d) {
          d.classList.remove('is-open');
          var links = [].slice.call(d.querySelectorAll('.mega-nav__panel-link'));
          if (links.length) {
            gsap.set(links, { clearProps: 'opacity,visibility,transform' });
          }
        }
        var t = toggle(name);
        if (t) t.setAttribute('aria-expanded', 'false');
        if (S.aStd === name) S.aStd = null;
      }

      [].slice.call(document.querySelectorAll('[data-std-dropdown]')).forEach(function (d) {
        var myName = d.getAttribute('data-std-dropdown');
        d.addEventListener('mouseenter', function () {
          clearTimeout(S.st);
          S.st = null;
        });
        d.addEventListener('mouseleave', function () {
          if (S.aStd !== myName) return;
          S.st = setTimeout(cStd, HOVER_LEAVE);
        });
      });
      [].slice.call(document.querySelectorAll('[data-nav-mode="dropdown"] .mega-nav__bar-link-wrap')).forEach(function (w) {
        var btn = w.querySelector('[data-dropdown-toggle]');
        var myName = btn ? btn.getAttribute('data-dropdown-toggle') : null;
        w.addEventListener('mouseenter', function () {
          clearTimeout(S.st);
          S.st = null;
        });
        w.addEventListener('mouseleave', function () {
          if (S.aStd !== myName) return;
          S.st = setTimeout(cStd, HOVER_LEAVE);
        });
      });

      function od(n) {
        var t = toggle(n);
        if (t && mode(t) === 'dropdown') return;
        if (S.isOpen && S.ap === n) return;
        if (S.isOpen) return sp(S.ap, n);
        var h = mp(n);
        if (!h) return;
        kd();
        rd();
        var e = panel(n),
          f = fade(e);
        S.isOpen = true;
        S.ap = n;
        S.api = megaIdx(n);
        wrap.setAttribute('data-menu-open', 'true');
        if (t) t.setAttribute('aria-expanded', 'true');
        gsap.set(dc, { height: 0 });
        var tl = gsap.timeline();
        S.tl = tl;
        tl.to(bd, { autoAlpha: 1, duration: MEGA_DUR.backdropIn, ease: 'power2.out' }, 0);
        tl.to(dc, { height: h, duration: MEGA_DUR.openScale, ease: 'power3.out' }, 0);
        tl.set(e, { visibility: 'visible', opacity: 1, pointerEvents: 'auto' }, 0.05);
        if (f.length) tl.fromTo(f, { autoAlpha: 0, y: 8 }, { autoAlpha: 1, y: 0, duration: MEGA_DUR.contentIn, stagger: stag(f.length), ease: 'power3.out' }, 0.1);
      }
      function cd() {
        if (!S.isOpen) return;
        var e = panel(S.ap),
          f = e ? fade(e) : [];
        kd();
        var tl = gsap.timeline({
          onComplete: function () {
            S.isOpen = false;
            S.ap = null;
            S.api = -1;
            S.tl = null;
            rd();
          },
        });
        S.tl = tl;
        if (f.length) tl.to(f, { autoAlpha: 0, y: -4, duration: MEGA_DUR.contentOut * 0.7, ease: 'power2.in' }, 0);
        tl.to(dc, { height: 0, duration: MEGA_DUR.closeScale, ease: 'power2.in' }, 0.05);
        tl.to(bd, { autoAlpha: 0, duration: MEGA_DUR.backdropOut, ease: 'power2.out' }, 0);
        if (e) tl.set(e, { visibility: 'hidden', opacity: 0, pointerEvents: 'none' });
      }
      function sp(fn, tn) {
        var dir = megaIdx(tn) > megaIdx(fn) ? 1 : -1,
          fe = panel(fn),
          te = panel(tn);
        if (!fe || !te) return;
        var ff = fade(fe),
          tf = fade(te),
          th = mp(tn);
        if (!th) return;
        kd();
        panels.forEach(function (p) {
          gsap.set(p, { visibility: 'hidden', opacity: 0, pointerEvents: 'none', xPercent: 0 });
          gsap.set(fade(p), { autoAlpha: 0, x: 0, y: 0 });
        });
        gsap.set(fe, { visibility: 'visible', opacity: 1, pointerEvents: 'auto', x: 0 });
        if (ff.length) gsap.set(ff, { autoAlpha: 1, x: 0, y: 0 });
        gsap.set(bd, { autoAlpha: 1 });
        var tt = toggle(tn);
        S.ap = tn;
        S.api = megaIdx(tn);
        rt();
        if (tt) tt.setAttribute('aria-expanded', 'true');
        var xo = dir * -30,
          xi = dir * 30,
          tl = gsap.timeline();
        S.tl = tl;
        if (ff.length) tl.to(ff, { autoAlpha: 0, x: xo, duration: MEGA_DUR.contentOut, ease: 'power2.in' }, 0);
        tl.set(fe, { visibility: 'hidden', opacity: 0, pointerEvents: 'none', xPercent: 0 }, MEGA_DUR.contentOut);
        if (ff.length) tl.set(ff, { x: 0 }, MEGA_DUR.contentOut);
        tl.to(dc, { height: th, duration: MEGA_DUR.bgMorph, ease: 'power3.out' }, 0.05);
        tl.set(te, { visibility: 'visible', opacity: 1, pointerEvents: 'auto', xPercent: 0 }, MEGA_DUR.contentOut * 0.5);
        if (tf.length) tl.fromTo(tf, { autoAlpha: 0, x: xi }, { autoAlpha: 1, x: 0, duration: MEGA_DUR.contentIn, stagger: stag(tf.length), ease: 'power3.out' }, MEGA_DUR.contentOut * 0.6);
      }

      function hEnter(e) {
        if (S.mob) return;
        var b = e.currentTarget,
          n = b.getAttribute('data-dropdown-toggle'),
          m = mode(b);
        if (m === 'dropdown') {
          clearTimeout(S.st);
          S.st = null;
          if (S.isOpen) cd();
          ct();
          oStd(n);
          return;
        }
        if (m === 'mega') {
          cStd();
          clearTimeout(S.lt);
          S.lt = null;
          clearTimeout(S.ht);
          S.ht = setTimeout(
            function () {
              od(n);
            },
            S.isOpen ? 0 : HOVER_ENTER,
          );
        }
      }
      function hLeave(e) {
        if (S.mob) return;
        var m = mode(e.currentTarget);
        if (m === 'dropdown') {
          S.st = setTimeout(cStd, HOVER_LEAVE);
          return;
        }
        if (m === 'mega') {
          clearTimeout(S.ht);
          S.ht = null;
          S.lt = setTimeout(cd, HOVER_LEAVE);
        }
      }
      function hEsc(e) {
        if (e.key !== 'Escape') return;
        if (S.mob) {
          S.mPanel ? cMP() : S.mOpen && cMM();
          return;
        }
        if (S.aStd) {
          cStd();
          return;
        }
        if (S.isOpen) {
          var t = toggle(S.ap);
          cd();
          if (t) t.focus();
        }
      }
      function hDoc(e) {
        if (S.mob) return;
        if (!e.target.closest('[data-menu-wrap]')) {
          cd();
          cStd();
        }
      }
      function hKey(e) {
        if (S.mob) return;
        var n = e.currentTarget.getAttribute('data-dropdown-toggle'),
          m = mode(e.currentTarget);
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          if (m === 'mega') {
            S.isOpen && S.ap === n ? cd() : od(n);
          } else if (m === 'dropdown') {
            S.aStd === n ? cStd() : oStd(n);
          }
        }
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          if (m === 'mega') od(n);
          if (m === 'dropdown') oStd(n);
        }
      }
      function hKP(e) {
        if (S.mob || !S.isOpen) return;
        var el = panel(S.ap);
        if (!el) return;
        var lk = [].slice.call(el.querySelectorAll('a')),
          i = lk.indexOf(document.activeElement);
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          lk[(i + 1) % lk.length].focus();
        }
        if (e.key === 'ArrowUp') {
          e.preventDefault();
          if (i <= 0) {
            var t = toggle(S.ap);
            if (t) t.focus();
          } else lk[i - 1].focus();
        }
      }

      function toggleMobileStd(n) {
        var d = stdDd(n);
        if (!d) return;
        var t = toggle(n);
        var inner = d.querySelector('.mega-nav__std-dropdown-inner');
        if (!inner) return;
        if (d.classList.contains('is-mob-open')) {
          /* Close */
          gsap.to(inner, {
            height: 0,
            opacity: 0,
            duration: 0.3,
            ease: 'power2.inOut',
            onComplete: function () {
              d.classList.remove('is-mob-open');
              inner.style.height = '';
              inner.style.opacity = '';
              if (t) t.setAttribute('aria-expanded', 'false');
            },
          });
        } else {
          /* Open */
          d.classList.add('is-mob-open');
          if (t) t.setAttribute('aria-expanded', 'true');
          var h = inner.scrollHeight;
          gsap.fromTo(
            inner,
            { height: 0, opacity: 0 },
            {
              height: h,
              opacity: 1,
              duration: 0.35,
              ease: 'power3.out',
              onComplete: function () {
                inner.style.height = 'auto';
              },
            },
          );
        }
      }

      function hClick(e) {
        if (!S.mob || !S.mOpen) return;
        var n = e.currentTarget.getAttribute('data-dropdown-toggle');
        if (!n) return;
        e.preventDefault();
        var m = mode(e.currentTarget);
        if (m === 'dropdown') {
          toggleMobileStd(n);
          return;
        }
        oMP(n);
      }

      function aB(x) {
        var tl = gsap.timeline({ defaults: { ease: 'power2.inOut' } });
        if (x) {
          tl.to(lt, { y: '0.3125rem', duration: 0.15 }, 0);
          tl.to(lb, { y: '-0.3125rem', duration: 0.15 }, 0);
          tl.to(lm, { autoAlpha: 0, duration: 0.1 }, 0.1);
          tl.to(lt, { rotation: 45, duration: 0.2 }, 0.15);
          tl.to(lb, { rotation: -45, duration: 0.2 }, 0.15);
        } else {
          tl.to(lt, { rotation: 0, duration: 0.2 }, 0);
          tl.to(lb, { rotation: 0, duration: 0.2 }, 0);
          tl.to(lt, { y: 0, duration: 0.15 }, 0.15);
          tl.to(lb, { y: 0, duration: 0.15 }, 0.15);
          tl.to(lm, { autoAlpha: 1, duration: 0.1 }, 0.15);
        }
        return tl;
      }
      function oMM() {
        km();
        S.mOpen = true;
        wrap.setAttribute('data-menu-open', 'true');
        burger.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
        var it = navItems(),
          tl = gsap.timeline();
        S.mtl = tl;
        tl.add(aB(true), 0);
        tl.to(navList, { autoAlpha: 1, duration: 0.3, ease: 'power2.out' }, 0);
        if (it.length) tl.fromTo(it, { autoAlpha: 0, y: 12 }, { autoAlpha: 1, y: 0, duration: 0.3, stagger: 0.04, ease: 'power3.out' }, 0.15);
      }
      function cMM() {
        var hp = S.mPanel,
          m = hp ? mode(toggle(hp)) : null,
          pe = hp && m === 'mega' ? panel(hp) : null,
          se = hp && m === 'dropdown' ? stdDd(hp) : null;
        km();
        kmp();
        wrap.setAttribute('data-menu-open', 'false');
        S.mOpen = false;
        S.mPanel = null;
        burger.setAttribute('aria-expanded', 'false');
        var tl = gsap.timeline({
          onComplete: function () {
            document.body.style.overflow = '';
            S.mtl = null;
            sm();
          },
        });
        S.mtl = tl;
        tl.add(aB(false), 0);
        if (pe) tl.to(pe, { autoAlpha: 0, duration: 0.3, ease: 'power2.inOut' }, 0.05);
        if (se) tl.to(se, { autoAlpha: 0, duration: 0.3, ease: 'power2.inOut' }, 0.05);
        if (hp) tl.to(back, { autoAlpha: 0, duration: 0.2, ease: 'power2.in' }, 0.05);
        tl.to(navList, { autoAlpha: 0, duration: 0.3, ease: 'power2.inOut' }, 0.05);
      }
      function oMP(n) {
        var t = toggle(n),
          m = mode(t),
          e,
          fi;
        if (m === 'dropdown') {
          e = stdDd(n);
          fi = e ? [].slice.call(e.querySelectorAll('a')) : [];
        } else {
          e = panel(n);
          fi = e ? [].slice.call(fade(e)) : [];
        }
        if (!e) return;
        kmp();
        S.mPanel = n;
        var ni = navItems(),
          tl = gsap.timeline();
        S.mptl = tl;
        if (ni.length) tl.to(ni, { xPercent: -10, autoAlpha: 0, duration: 0.35, stagger: 0.03, ease: 'power2.in' }, 0);
        tl.to(logo, { autoAlpha: 0, duration: 0.2, ease: 'power2.in' }, 0);
        tl.to(back, { autoAlpha: 1, duration: 0.25, ease: 'power2.inOut' }, 0.15);
        tl.set(e, { autoAlpha: 1, xPercent: 0, pointerEvents: 'auto', visibility: 'visible', display: 'flex' }, 0.2);
        if (fi.length) tl.fromTo(fi, { xPercent: 8, autoAlpha: 0 }, { xPercent: 0, autoAlpha: 1, duration: 0.3, stagger: stag(fi.length), ease: 'power3.out' }, 0.25);
      }
      function cMP() {
        if (!S.mPanel) return;
        var n = S.mPanel,
          t = toggle(n),
          m = mode(t),
          e,
          fi;
        if (m === 'dropdown') {
          e = stdDd(n);
          fi = e ? [].slice.call(e.querySelectorAll('a')) : [];
        } else {
          e = panel(n);
          fi = e ? [].slice.call(fade(e)) : [];
        }
        if (!e) return;
        kmp();
        var ni = navItems(),
          tl = gsap.timeline({
            onComplete: function () {
              S.mPanel = null;
              S.mptl = null;
            },
          });
        S.mptl = tl;
        if (fi.length) tl.to(e, { xPercent: 20, autoAlpha: 0, duration: 0.3, ease: 'power2.in' }, 0);
        tl.set(e, { autoAlpha: 0, pointerEvents: 'none' }, 0.25);
        tl.to(back, { autoAlpha: 0, duration: 0.2, ease: 'power2.in' }, 0);
        tl.to(logo, { autoAlpha: 1, duration: 0.25, ease: 'power2.out' }, 0.15);
        if (ni.length) tl.fromTo(ni, { xPercent: -20, autoAlpha: 0 }, { xPercent: 0, autoAlpha: 1, duration: 0.35, stagger: 0.03, ease: 'power3.out' }, 0.25);
      }

      var rT = null,
        lW = window.innerWidth;
      function hR() {
        var w = window.innerWidth;
        if (w === lW) return;
        lW = w;
        clearTimeout(rT);
        rT = setTimeout(function () {
          var was = S.mob;
          S.mob = window.innerWidth <= MOBILE_BP;
          if (was && !S.mob) {
            km();
            kmp();
            gsap.set(navList, { clearProps: 'all' });
            gsap.set(navItems(), { clearProps: 'all' });
            gsap.set(back, { autoAlpha: 0 });
            gsap.set(logo, { clearProps: 'all' });
            gsap.set([lt, lm, lb], { rotation: 0, y: 0, autoAlpha: 1 });
            burger.setAttribute('aria-expanded', 'false');
            S.mOpen = false;
            S.mPanel = null;
            document.body.style.overflow = '';
            rd();
          }
          if (!was && S.mob) {
            kd();
            cStd();
            S.isOpen = false;
            S.ap = null;
            S.api = -1;
            ct();
            wrap.setAttribute('data-menu-open', 'false');
            rt();
            sm();
          }
        }, 150);
      }

      allT.forEach(function (b) {
        b.addEventListener('mouseenter', hEnter);
        b.addEventListener('mouseleave', hLeave);
        b.addEventListener('keydown', hKey);
        b.addEventListener('click', hClick);
      });
      if (dw) {
        dw.addEventListener('mouseenter', function () {
          if (!S.mob) {
            clearTimeout(S.lt);
            S.lt = null;
          }
        });
        dw.addEventListener('mouseleave', function () {
          if (!S.mob) S.lt = setTimeout(cd, HOVER_LEAVE);
        });
      }
      panels.forEach(function (p) {
        p.addEventListener('keydown', hKP);
      });
      if (bd) bd.addEventListener('click', cd);
      document.addEventListener('keydown', hEsc);
      document.addEventListener('click', hDoc);
      if (burger)
        burger.addEventListener('click', function () {
          S.mOpen ? cMM() : oMM();
        });
      if (back) back.addEventListener('click', cMP);
      /* Close mobile menu when any link inside nav is tapped */
      wrap.addEventListener('click', function (e) {
        if (!S.mob || !S.mOpen) return;
        var link = e.target.closest('a');
        if (!link) return;
        if (link.closest('[data-dropdown-toggle]')) return;
        cMM();
      });
      window.addEventListener('resize', hR);
      S.mob ? sm() : rd();
    }
  })();
</script><script>
const boxes=[...document.querySelectorAll('.checklist input')];
const count=document.querySelector('.checkcount');
if(count){count.hidden=false; const update=()=>count.textContent=boxes.filter(b=>b.checked).length+' von '+boxes.length+' Punkten anhand Ihrer Unterlagen geprüft'; boxes.forEach(b=>b.addEventListener('change',update));update();}
const button=document.getElementById('copy-button');
if(button){button.hidden=false;button.addEventListener('click',async()=>{const text=document.getElementById('copy-text');const status=document.getElementById('copy-status');try{await navigator.clipboard.writeText(text.textContent);status.textContent='Gesprächseinstieg kopiert.';}catch{const range=document.createRange();range.selectNodeContents(text);const selection=window.getSelection();selection.removeAllRanges();selection.addRange(range);status.textContent='Automatisches Kopieren ist nicht verfügbar. Der Text ist markiert und kann manuell kopiert werden.';}});}
</script>